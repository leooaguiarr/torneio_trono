{
  "entities": {
    "Participant": {
      "title": "Participant",
      "description": "A competitor in the Torneio do Trono league",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the participant"
        },
        "name": {
          "type": "string",
          "description": "Display name of the competitor",
          "maxLength": 60
        },
        "nickname": {
          "type": "string",
          "description": "Humorous title or nickname",
          "maxLength": 60
        },
        "avatar": {
          "type": "string",
          "description": "Emoji character representing the participant",
          "maxLength": 10
        },
        "color": {
          "type": "string",
          "description": "Color theme token for the participant card",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the participant was added"
        }
      },
      "required": ["id", "name", "avatar", "color", "createdAt"]
    },
    "PoopEntry": {
      "title": "PoopEntry",
      "description": "A logged bathroom visit with effort level, timing and details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the entry"
        },
        "participantId": {
          "type": "string",
          "description": "ID of the participant who logged this entry",
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "description": "ISO string timestamp of the bathroom visit",
          "maxLength": 40
        },
        "effortLevel": {
          "type": "number",
          "description": "Effort score from 1 (easy) to 5 (epic/volcanic)",
          "enum": [1, 2, 3, 4, 5]
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration spent on the throne in minutes"
        },
        "location": {
          "type": "string",
          "description": "Location category (casa, trabalho, rua, amigo, viagem, outro)",
          "maxLength": 30
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or amusing context",
          "maxLength": 200
        },
        "createdBy": {
          "type": "string",
          "description": "User ID of the person who recorded this entry",
          "maxLength": 128
        }
      },
      "required": ["id", "participantId", "timestamp", "effortLevel"]
    },
    "MonthWinnerRecord": {
      "title": "MonthWinnerRecord",
      "description": "Information about the reigning champion of the previous month",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "description": "Identifier key for the month (e.g. 2026-07)",
          "maxLength": 20
        },
        "monthName": {
          "type": "string",
          "description": "Formatted name of the month",
          "maxLength": 60
        },
        "participantId": {
          "type": "string",
          "description": "ID of winning participant",
          "maxLength": 128
        },
        "participantName": {
          "type": "string",
          "description": "Name of winning participant",
          "maxLength": 60
        },
        "participantAvatar": {
          "type": "string",
          "description": "Avatar of winning participant",
          "maxLength": 10
        },
        "nickname": {
          "type": "string",
          "description": "Champion nickname",
          "maxLength": 60
        },
        "totalCount": {
          "type": "number",
          "description": "Total visits logged by the champion in that month"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp when champion was crowned",
          "maxLength": 40
        }
      },
      "required": ["monthKey", "monthName", "participantId", "participantName", "totalCount", "timestamp"]
    }
  },
  "firestore": {
    "/participants/{participantId}": {
      "schema": "Participant",
      "description": "Collection of league competitors"
    },
    "/entries/{entryId}": {
      "schema": "PoopEntry",
      "description": "Collection of logged bathroom entries for the leaderboard and stats"
    },
    "/metadata/{docId}": {
      "schema": "MonthWinnerRecord",
      "description": "App metadata including monthly champions record"
    }
  }
}
